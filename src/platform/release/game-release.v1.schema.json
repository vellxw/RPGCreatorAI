{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpgcreatorai.local/schemas/game-release.v1.json",
  "title": "RPGCreatorAI game release descriptor",
  "description": "Canonical game version identity shared by platform exporters. Editor package versions never participate.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "releaseId", "status", "version"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "releaseId": { "type": "string", "minLength": 1 },
        "status": { "const": "pending" },
        "version": { "type": "null" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "releaseId", "status", "version", "decidedAt", "decidedBy"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "releaseId": { "type": "string", "minLength": 1 },
        "status": { "const": "locked" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "decidedBy": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
