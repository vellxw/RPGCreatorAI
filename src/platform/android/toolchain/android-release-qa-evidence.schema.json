{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpgcreator.ai/schemas/android-release-qa-evidence.v1.json",
  "title": "RPGCreatorAI Android release QA evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "variant",
    "applicationId",
    "versionName",
    "versionCode",
    "gameReleaseSha256",
    "editorAcceptanceEvidenceSha256",
    "artifactSha256",
    "signatureVerified",
    "signingCertificateSha256",
    "verifiedAt",
    "offlineDevice"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "verified" },
    "variant": { "const": "release" },
    "applicationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "versionName": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 1 },
    "gameReleaseSha256": { "$ref": "#/$defs/sha256" },
    "editorAcceptanceEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "artifactSha256": { "$ref": "#/$defs/sha256" },
    "signatureVerified": { "const": true },
    "signingCertificateSha256": { "$ref": "#/$defs/sha256" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "offlineDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "device", "androidApi", "checks"],
      "properties": {
        "status": { "const": "passed" },
        "device": { "type": "string", "minLength": 1 },
        "androidApi": { "type": "integer", "minimum": 24 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
