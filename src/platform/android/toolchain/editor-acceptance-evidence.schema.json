{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpgcreator.ai/schemas/editor-acceptance-evidence.v1.json",
  "title": "RPGCreatorAI editor acceptance evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "status",
    "reviewedAt",
    "reviewer",
    "reviewPacketSha256",
    "reviewChecklistSha256",
    "gameBundleSha256",
    "assetManifestSha256",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "const": "accepted" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["human", "delegated-by-creator"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "reviewPacketSha256": { "$ref": "#/$defs/sha256" },
    "reviewChecklistSha256": { "$ref": "#/$defs/sha256" },
    "gameBundleSha256": { "$ref": "#/$defs/sha256" },
    "assetManifestSha256": { "$ref": "#/$defs/sha256" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "kind", "status", "sha256"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": { "enum": ["asset", "dialogue", "map", "game-bundle", "asset-manifest"] },
          "status": { "const": "accepted" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "notes": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
