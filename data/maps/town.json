  "events": [
    {
      "id": "old_man",
      "type": "npc",
      "x": 20,
      "y": 9,
      "solid": true,
      "sprite": "npc_old_man",
      "animationSet": "npc_old_man",
      "trigger": "interact",
      "commands": [
        {
          "type": "playAnimation",
          "target": "player",
          "action": "interact",
          "direction": "current",
          "durationMs": 500,
          "blocking": false,
          "loop": false
        },
        {
          "type": "ifSwitch",
          "switchId": "talked_to_old_man",
          "equals": false,
          "then": [
            {
              "type": "showText",
              "speaker": "Anciano",
              "text": "Hola viajero. He perdido un cofre en mi casa."
            },
            {
              "type": "showChoices",
              "prompt": "\u00c2\u00bfLe ayudas?",
              "choices": [
                {
                  "label": "S\u00c3\u00ad, te ayudar\u00c3\u00a9",
                  "commands": [
                    {
                      "type": "showText",
                      "speaker": "Anciano",
                      "text": "Mil gracias. Toma esta moneda como pago inicial."
                    },
                    {
                      "type": "addGold",
                      "amount": 10
                    },
                    {
                      "type": "startQuest",
                      "questId": "lost_chest"
                    },
                    {
                      "type": "controlSwitch",
                      "switchId": "talked_to_old_man",
                      "value": true
                    }
                  ]
                },
                {
                  "label": "Mejor no",
                  "commands": [
                    {
                      "type": "showText",
                      "speaker": "Anciano",
                      "text": "Est\u00c3\u00a1 bien. Vuelve si cambias de idea."
                    }
                  ]
                }
              ]
            }
          ],
          "else": [
            {
              "type": "ifSwitch",
              "switchId": "chest_001_opened",
              "equals": true,
              "then": [
                {
                  "type": "showText",
                  "speaker": "Anciano",
                  "text": "\u00c2\u00a1Encontraste el cofre! Toma esta recompensa."
                },
                {
                  "type": "addGold",
                  "amount": 30
                },
                {
                  "type": "addItem",
                  "itemId": "potion",
                  "amount": 1
                },
                {
                  "type": "completeQuest",
                  "questId": "lost_chest"
                }
              ],
              "else": [
                {
                  "type": "showText",
                  "speaker": "Anciano",
                  "text": "Mi cofre est\u00c3\u00a1 dentro de la casa, sobre la repisa."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "shop_keeper",
      "type": "npc",
      "x": 31,
      "y": 13,
      "solid": true,
      "sprite": "npc_shopkeeper",
      "animationSet": "npc_shopkeeper",
      "trigger": "interact",
      "commands": [
        {
          "type": "playAnimation",
          "target": "player",
          "action": "interact",
          "direction": "current",
          "durationMs": 500,
          "blocking": false,
          "loop": false
        },
        {
          "type": "showText",
          "speaker": "Tendera",
          "text": "Echa un vistazo a mis pociones."
        },
        {
          "type": "openShop",
          "shopId": "town_shop"
        }
      ]
    },
    {
      "id": "wild_slime",
      "type": "object",
      "x": 10,
      "y": 18,
      "solid": false,
      "sprite": "enemy_slime",
      "trigger": "touch",
      "commands": [
        {
          "type": "ifSwitch",
          "switchId": "first_battle_done",
          "equals": false,
          "then": [
            {
              "type": "playAnimation",
              "target": "player",
              "action": "hurt",
              "direction": "current",
              "durationMs": 350,
              "blocking": false,
              "loop": false
            },
            {
              "type": "showText",
              "text": "\u00c2\u00a1Un par de slimes te ataca!"
            },
            {
              "type": "playAnimation",
              "target": "player",
              "action": "attack",
              "direction": "current",
              "durationMs": 450,
              "blocking": false,
              "loop": false
            },
            {
              "type": "startBattle",
              "troopId": "slime_pair",
              "canEscape": false,
              "victoryBranch": [
                {
                  "type": "showText",
                  "text": "\u00c2\u00a1Victoria! Ganaste experiencia y oro."
                },
                {
                  "type": "controlSwitch",
                  "switchId": "first_battle_done",
                  "value": true
                },
                {
                  "type": "controlVariable",
                  "variableId": "lost_chest_progress",
                  "op": "add",
                  "value": 1
                }
              ],
              "defeatBranch": [
                {
                  "type": "playAnimation",
                  "target": "player",
                  "action": "death",
                  "direction": "current",
                  "durationMs": 700,
                  "blocking": true,
                  "loop": false
                },
                {
                  "type": "showText",
                  "text": "Has ca\u00c3\u00addo... Despiertas en el pueblo."
                }
              ]
            }
          ],
          "else": [
            {
              "type": "showText",
              "text": "Solo queda un rastro de baba."
            }
          ]
        }
      ]
    },
    {
      "id": "door_to_house",
