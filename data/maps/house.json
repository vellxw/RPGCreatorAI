    {
      "id": "chest_001",
      "type": "chest",
      "x": 30,
      "y": 10,
      "solid": true,
      "sprite": "chest_closed",
      "trigger": "interact",
      "commands": [
        {
          "type": "ifSwitch",
          "switchId": "chest_001_opened",
          "equals": false,
          "then": [
            {
              "type": "showText",
              "text": "Encontraste una pocion."
            },
            {
              "type": "addItem",
              "itemId": "potion",
              "amount": 1
            },
            {
              "type": "playSound",
              "soundId": "chest_open"
            },
            {
              "type": "controlSwitch",
              "switchId": "chest_001_opened",
              "value": true
            },
            {
              "type": "ifVariable",
              "variableId": "lost_chest_progress",
              "op": "lt",
              "value": 1,
              "then": [
                {
                  "type": "controlVariable",
                  "variableId": "lost_chest_progress",
                  "op": "set",
                  "value": 1
                }
              ],
              "else": []
            },
            {
              "type": "updateQuestObjective",
              "questId": "lost_chest",
              "objectiveId": "open_chest",
              "state": "done"
            }
          ],
          "else": [
            {
              "type": "showText",
              "text": "El cofre esta vacio."
            }
          ]
        }
      ]
    }
