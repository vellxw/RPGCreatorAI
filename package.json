{
  "name": "rpgcreator-ai-editor",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Open source RPG creation toolkit with a React/Tauri editor and native C++ data-driven runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vellxw/RPGCreatorAI.git"
  },
  "homepage": "https://github.com/vellxw/RPGCreatorAI#readme",
  "bugs": {
    "url": "https://github.com/vellxw/RPGCreatorAI/issues"
  },
  "keywords": [
    "rpg",
    "game-engine",
    "game-editor",
    "tauri",
    "react",
    "typescript",
    "cpp",
    "cmake",
    "rpg-maker",
    "ai-assisted"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:tauri": "vite --port=1420 --strictPort --host=127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:mvp:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/verify.ps1",
    "verify:runtime:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/verify.ps1 -SkipSmoke -SkipFrontend -SkipDesktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --debug --no-bundle",
    "desktop:verify-content": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/verify-tauri-content.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.577.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^4.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6"
  }
}
